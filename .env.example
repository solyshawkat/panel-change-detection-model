# ═══════════════════════════════════════════
#  PCD-AI Service Configuration
# ═══════════════════════════════════════════

# ── Application ──
APPLICATION_PORT=8100
DEBUG=false

# ── Database (same PostgreSQL server as analytics) ──
DB_HOST=10.80.3.231
DB_PORT=5433
DB_NAME=eden_crm_sec_crm
DB_USERNAME=pcd_user
DB_PASSWORD=
DB_SCHEMA=public

# ── Eureka Service Discovery ──
EUREKA_ENABLED=true
EUREKA_URL=http://127.0.0.1:8761/eureka
EUREKA_INSTANCE_HOST=

# ── Pipeline Thresholds ──
FRAUD_THRESHOLD=0.751
SVM_THRESHOLD=0.389
ALIGNMENT_MIN_INLIERS=10

# ── Oracle Cloud (Image Storage) ──
ORACLE_CLOUD_ENABLED=false
ORACLE_CLOUD_NAMESPACE=
ORACLE_CLOUD_BUCKET=
ORACLE_CLOUD_REGION=me-jeddah-1

# ── Storage ──
STORAGE_ROOT=storage
BASELINE_DIR=storage/baselines
HEATMAP_DIR=storage/heatmaps
MODEL_DIR=ml_models
